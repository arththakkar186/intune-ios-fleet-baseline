{
  "@odata.type": "#microsoft.graph.iosManagedAppProtection",
  "displayName": "iOS - App protection - Microsoft 365 apps",
  "description": "Managed by intune-ios-fleet-baseline. Applies to corporate and personal (BYOD) devices.",
  "pinRequired": true,
  "minimumPinLength": 6,
  "simplePinBlocked": true,
  "pinCharacterSet": "numeric",
  "maximumPinRetries": 5,
  "fingerprintBlocked": false,
  "faceIdBlocked": false,
  "periodBeforePinReset": "PT0S",
  "periodOnlineBeforeAccessCheck": "PT30M",
  "periodOfflineBeforeAccessCheck": "PT12H",
  "periodOfflineBeforeWipeIsEnforced": "P90D",
  "allowedInboundDataTransferSources": "managedApps",
  "allowedOutboundDataTransferDestinations": "managedApps",
  "allowedOutboundClipboardSharingLevel": "managedAppsWithPasteIn",
  "allowedOutboundClipboardSharingExceptionLength": 0,
  "organizationalCredentialsRequired": false,
  "dataBackupBlocked": true,
  "saveAsBlocked": true,
  "printBlocked": false,
  "contactSyncBlocked": false,
  "deviceComplianceRequired": true,
  "managedBrowserToOpenLinksRequired": true,
  "managedBrowser": "microsoftEdge",
  "disableAppPinIfDevicePinIsSet": false,
  "minimumRequiredOsVersion": "18.0",
  "minimumWarningOsVersion": "18.7",
  "appDataEncryptionType": "whenDeviceLocked",
  "appActionIfDeviceComplianceRequired": "block",
  "appActionIfMaximumPinRetriesExceeded": "block",
  "targetedAppManagementLevels": "unspecified",
  "apps": [
    "com.microsoft.Office.Outlook",
    "com.microsoft.skype.teams",
    "com.microsoft.sharepoint",
    "com.microsoft.skydrive",
    "com.microsoft.Office.Word",
    "com.microsoft.Office.Excel",
    "com.microsoft.Office.Powerpoint",
    "com.microsoft.msedge",
    "com.microsoft.officemobile",
    "com.microsoft.to-do"
  ]
}
